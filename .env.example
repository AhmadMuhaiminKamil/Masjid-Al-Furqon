# ============================================
# TEMPLATE ENV
# Lokal  : salin ke .env.local
# Vercel : Settings > Environment Variables (isi satu per satu)
# ============================================

# ---------- Database (Supabase Postgres) ----------
# Pooler port 6543 - WAJIB untuk Vercel (serverless)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"

# Direct port 5432 - untuk migration/seeding
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ---------- Auth ----------
# Generate: openssl rand -base64 48
JWT_SECRET="ganti-dengan-string-acak-panjang"

# ---------- Supabase API ----------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key-dari-supabase"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-dari-supabase"
SUPABASE_STORAGE_BUCKET="masjid-images"

# ---------- Site ----------
# Ganti saat deploy, misal https://masjid-alfurqon.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Seeding (khusus npm run db:seed) ----------
# Password admin WAJIB diset saat seeding, minimal 8 karakter
SEED_ADMIN_EMAIL="admin@masjidalfurqon.id"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
